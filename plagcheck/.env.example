APP_PORT=5000
DB_HOST=localhost
DB_NAME=plagcheck_db
DB_USER=plagcheck_user
DB_PASS=change-me
DB_PORT=5432
DEFAULT_THRESHOLD=0.70
DEFAULT_MODE=text_similarity

# "Compare against the internet" (code_similarity / text_similarity only).
# Blank WEB_SEARCH_API_KEY / WEB_SEARCH_ENGINE_ID means the feature is
# unconfigured: scans relying on the default fall back to offline
# file-vs-file comparison; an explicit include_web=true request gets a
# 400 web_search_unavailable instead. See plagcheck/src/websearch.py.
WEB_SEARCH_PROVIDER=google_cse
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE_ID=
WEB_SEARCH_MAX_QUERIES_PER_SCAN=5
WEB_SEARCH_MAX_RESULTS_PER_QUERY=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_BUDGET_SECONDS=20
