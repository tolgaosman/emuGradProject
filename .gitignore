# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
# `pytest` now runs from the repo root (see pyproject.toml), so coverage.py
# writes its data file here, not plagcheck/.coverage. It regenerates on every
# run, so it's ignored like any other build artifact — this is distinct from
# the tracked plagcheck/.coverage, which is a frozen historical snapshot.
/.coverage
.coverage.*
htmlcov/
*.egg-info/

# Local env overrides (plagcheck/.env itself is tracked; a real deployment
# should override its placeholder credentials via .env.local, never commit it)
.env.local

# Logs
*.log

# Generated scan artifacts (keep the directory placeholder)
/output/*
!/output/.gitkeep

# Node / React (web/)
node_modules/
web/dist/
web/.vite/
web/*.local

# Editor / OS
.DS_Store
Thumbs.db

# Archives (submission bundles are build output, not source)
*.zip
